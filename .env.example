# Postgres connection string.
#
# Local dev: docker compose up -d, then copy this file to .env.local with:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/ctrltee
#
# Production (Vercel): set DATABASE_URL to your real Postgres connection
# string (Vercel Postgres / Neon / etc.) in the project's Environment
# Variables — do not commit real credentials here.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production (Vercel): set your own generated value as an environment
# variable — never reuse the local dev value in production.
AUTH_SECRET=change-me-generate-a-real-secret

# Used only by `pnpm db:create-admin` to create/update the one admin account.
# Not read by the app itself at runtime — safe to change or remove after use.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
